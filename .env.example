# UniFlow AI - Environment Variables
# Copy this file to .env.local and populate with your actual Supabase and automation keys

# Supabase Configuration (Required for database & storage)
# Find these in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Make.com / Webhook Automation Endpoints (Optional for backend triggers)
# Triggered when student submits an application for AI doc verification
VITE_MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-submission-webhook-id

# Triggered when admin takes an approval/rejection/request documents decision
VITE_MAKE_ADMIN_ACTION_WEBHOOK=https://hook.eu1.make.com/your-admin-action-webhook-id

# NOTE: NEVER EXPOSE SUPABASE_SERVICE_ROLE_KEY IN THIS FILE OR CLIENT-SIDE CODE.
